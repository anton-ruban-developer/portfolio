---
// Головна сторінка. Одна для всіх мов: тексти підставляються зі словника
// за адресою сторінки (/, /ru/, /en/).
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Stack from './Stack.astro';
import Portfolio from './Portfolio.astro';
import Services from './Services.astro';
import Process from './Process.astro';
import Why from './Why.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import { useT } from '../i18n';

const { t } = useT(Astro.currentLocale);
// питання-відповіді з блоку FAQ: Google може показати їх прямо в пошуку
const schema = [
  {
    '@type': 'FAQPage',
    mainEntity: t.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Layout schema={schema}>
  <main>
    <Hero />
    <Stack />
    <div class="band"><Portfolio /></div>
    <div class="band band--soft"><Services /></div>
    <div class="band band--yellow"><Process /></div>
    <div class="band band--grain"><Why /></div>
    <div class="band"><Faq /></div>
    <div class="band band--soft"><Contact /></div>
  </main>
</Layout>
