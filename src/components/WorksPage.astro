---
// Сторінка «Портфоліо»: /works/, /ru/works/, /en/works/.
// Проєкти: src/data/projects.ts + описи з t.portfolio.projects. Тексти сторінки: src/data/pages/works.ts
import Layout from '../layouts/Layout.astro';
import Contact from './Contact.astro';
import { projects } from '../data/projects';
import { works } from '../data/pages/works';
import { serviceUi, servicesFor } from '../data/services';
import { useT, localizePath } from '../i18n';

const { lang, t, home } = useT(Astro.currentLocale);
const w = works[lang];
const ui = serviceUi[lang];
const pt = t.portfolio;
const url = (path: string) => new URL(localizePath(lang, path), Astro.site ?? Astro.url).href;

const servicePages = new Set(servicesFor(lang).map((s) => s.slug));
const list = projects.map((p) => ({
  ...p,
  ...pt.projects[p.id],
  serviceHref: p.service && servicePages.has(p.service) ? localizePath(lang, `/${p.service}/`) : null,
}));

const srcset = (img: string) => `${img.replace('/portfolio/', '/portfolio/sm/')} 700w, ${img} 1200w`;

// Розмітка для Google: сторінка-колекція з переліком робіт і хлібні крихти
const schema = [
  {
    '@type': 'CollectionPage',
    name: w.h1,
    description: w.metaDescription,
    url: url('/works/'),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: list.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@type': 'CreativeWork', name: p.title, url: p.url, description: p.description, ...(p.image && { image: new URL(p.image, Astro.site ?? Astro.url).href }) },
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: url('/') },
      { '@type': 'ListItem', position: 2, name: w.eyebrow, item: url('/works/') },
    ],
  },
];
---

<Layout title={w.metaTitle} description={w.metaDescription} schema={schema}>
  <main>
    <section class="intro band">
      <div class="container">
        <nav class="crumbs" aria-label="breadcrumbs">
          <a href={home}>{ui.home}</a> <span aria-hidden="true">/</span> <span aria-current="page">{w.eyebrow}</span>
        </nav>
        <p class="eyebrow">{w.eyebrow}</p>
        <h1>{w.h1}</h1>
        <p class="text">{w.intro}</p>
        <div class="facts">
          {w.facts.map((f) => <div><strong>{f.value}</strong><span>{f.label}</span></div>)}
        </div>
      </div>
    </section>

    <section class="section container cases">
      {list.map((p, i) => (
        <article class:list={['case', { flip: i % 2 === 1 }]} data-reveal>
          <a class="shot spot" href={p.url} target="_blank" rel="noopener" aria-label={`${pt.openSiteAria}: ${p.title}`} style={`--t:${p.scroll ?? 10}s`}>
            <div class="bar">
              <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="addr">{new URL(p.url).hostname}</span>
              <span class="go" aria-hidden="true">↗</span>
            </div>
            <div class="view">
              {p.image
                ? <img src={p.image} srcset={srcset(p.image)} sizes="(max-width: 900px) calc(100vw - 32px), 640px" alt={`${p.title}: ${pt.screenshotAlt}`} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                : <div class="placeholder">{pt.screenshot}</div>}
              <span class="hint" aria-hidden="true">{w.hint}</span>
            </div>
          </a>

          <div class="body">
            <p class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <p class="type">{p.type}</p>
            <h2>{p.title}</h2>
            <p class="short">{p.short}</p>
            <p class="desc">{p.description}</p>
            {p.results && (
              <>
                <h3>{w.done}</h3>
                <ul>{p.results.map((r) => <li>{r}</li>)}</ul>
              </>
            )}
            <div class="tags" aria-label={w.stack}>{p.tags.map((tag) => <span>{tag}</span>)}</div>
            <div class="links">
              <a class="btn" href={p.url} target="_blank" rel="noopener">{pt.openSite}</a>
              {p.serviceHref && <a class="link" href={p.serviceHref}>{w.similar}</a>}
            </div>
          </div>
        </article>
      ))}
    </section>

    <div class="band band--soft glow"><Contact title={w.cta.title} lead={w.cta.text} /></div>
  </main>
</Layout>

<style>
  /* ---- перший екран ---- */
  .intro { overflow: hidden; padding: clamp(2rem, 6vw, 4.5rem) 0 clamp(2.5rem, 6vw, 4rem); }
  .intro::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(900px 520px at 88% -6%, rgba(7, 117, 243, .24), transparent 62%),
      radial-gradient(700px 480px at 0% 22%, rgba(255, 210, 0, .12), transparent 60%);
  }
  .intro::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .045) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 70%);
    mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 70%);
  }
  .crumbs { color: var(--muted); font-size: .85rem; margin-bottom: 1.75rem; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .crumbs [aria-current] { color: var(--text); }
  h1 { max-width: 18ch; }
  .text { color: var(--muted); font-size: 1.1rem; max-width: 62ch; margin-bottom: 2rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 1rem; }
  .facts div {
    display: grid; padding: .9rem 1.3rem; min-width: 150px;
    border: 1px solid rgba(255, 210, 0, .3); border-radius: 14px; background: rgba(255, 210, 0, .05);
  }
  .facts strong { font-family: var(--font-head); font-size: clamp(1.4rem, 3vw, 1.9rem); color: var(--accent); line-height: 1.1; }
  .facts span { color: var(--muted); font-size: .85rem; }

  /* ---- кейси ---- */
  .cases { display: grid; gap: clamp(4rem, 9vw, 7rem); }
  .case { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .case.flip .shot { order: 2; }

  .shot {
    display: block; text-decoration: none; color: inherit; overflow: hidden;
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 18px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .45);
    transition: border-color .25s, transform .25s;
  }
  .shot:hover { border-color: rgba(255, 210, 0, .55); transform: translateY(-4px); }
  .shot:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .bar { display: flex; align-items: center; gap: .9rem; padding: .65rem 1rem; border-bottom: 1px solid var(--line); }
  .dots { display: flex; gap: .4rem; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }
  .addr {
    flex: 1; min-width: 0; padding: .2rem .8rem; border-radius: 999px; background: rgba(255, 255, 255, .06);
    color: var(--muted); font: .75rem ui-monospace, Consolas, monospace; text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .go { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .25); transition: background .2s, color .2s; }
  .shot:hover .go { background: var(--accent); border-color: var(--accent); color: #111; }

  /* скріншот усієї сторінки прокручується при наведенні (на телефоні: коли картка в центрі екрана) */
  .view { position: relative; overflow: hidden; aspect-ratio: 16 / 10; container-type: size; background: #0b0e13; }
  .view img {
    position: absolute; top: 0; left: 0; width: 100%; height: auto;
    transition: transform 1.2s cubic-bezier(.4, 0, .2, 1); will-change: transform;
  }
  .shot:hover .view img, .shot.is-active .view img {
    transform: translateY(min(0px, calc(100cqh - 100%)));
    transition-duration: var(--t, 10s); transition-timing-function: cubic-bezier(.45, .05, .3, 1);
  }
  .placeholder { position: absolute; inset: 0; display: grid; place-items: center; color: var(--muted); }
  .hint {
    position: absolute; right: .8rem; bottom: .8rem; padding: .3rem .7rem; border-radius: 999px;
    background: rgba(14, 17, 22, .85); color: var(--text); font-size: .75rem; font-weight: 600;
    transition: opacity .3s;
  }
  .shot:hover .hint { opacity: 0; }

  .body { position: relative; }
  .num {
    font-family: var(--font-head); font-weight: 800; line-height: 1; font-size: clamp(3rem, 6vw, 4.5rem);
    color: transparent; -webkit-text-stroke: 1.5px rgba(255, 210, 0, .55); margin-bottom: .5rem;
  }
  .type { color: var(--accent); font-weight: 700; font-size: .78rem; text-transform: uppercase; letter-spacing: .1em; }
  .body h2 { margin: .4rem 0 .3rem; }
  .short { color: var(--text); font-weight: 600; margin-bottom: .8rem; }
  .desc { color: var(--muted); margin-bottom: 1.25rem; max-width: 56ch; }
  .body h3 { font-size: .95rem; margin-bottom: .6rem; }
  .body ul { list-style: none; display: grid; gap: .4rem; margin-bottom: 1.25rem; }
  .body li { position: relative; padding-left: 1.4rem; font-size: .93rem; color: var(--muted); }
  .body li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: 800; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1.5rem; }
  .tags span { padding: .2rem .7rem; font-size: .75rem; background: rgba(255, 255, 255, .07); border-radius: 999px; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .link { color: var(--accent); font-weight: 700; text-decoration: none; }
  .link:hover { text-decoration: underline; }

  .glow::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(700px 400px at 85% 20%, rgba(7, 117, 243, .14), transparent 65%),
      radial-gradient(500px 360px at 10% 90%, rgba(255, 210, 0, .08), transparent 65%);
  }

  @media (max-width: 900px) {
    .case { grid-template-columns: 1fr; }
    .case.flip .shot { order: 0; }
  }
  @media (hover: none) { .hint { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .view img, .shot:hover .view img, .shot.is-active .view img { transition: none; transform: none; }
  }
</style>

<script>
  // на телефоні скриншот прокручується, коли картка в центрі екрана (на слабких пристроях вимкнено)
  if (window.matchMedia('(hover: none)').matches && !document.documentElement.classList.contains('lite') && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((en) => en.target.closest('.shot')?.classList.toggle('is-active', en.isIntersecting)),
      { threshold: 0.6 }
    );
    document.querySelectorAll('.shot .view').forEach((v) => io.observe(v));
  }
</script>
