---
import { site } from '../data/site';
import { useT } from '../i18n';

const { t } = useT(Astro.currentLocale);
---

<!-- Закріплена кнопка Telegram на телефоні: з'являється після першого екрана і ховається біля форми контактів -->
<div class="mcta" aria-hidden="true">
  <a class="btn" href={site.telegram} target="_blank" rel="noopener" tabindex="-1">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21.9 4.3 18.8 19c-.2 1-.8 1.3-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.8 8.8-7.9c.4-.3-.1-.5-.6-.2L6.8 13l-4.6-1.4c-1-.3-1-1 .2-1.5l18-6.9c.8-.3 1.6.2 1.5 1.1z"/></svg>
    {t.ui.telegramCta}
  </a>
</div>

<style>
  .mcta { display: none; }
  @media (max-width: 768px) {
    .mcta {
      display: block; position: fixed; z-index: 40; left: 0; right: 0; bottom: 0;
      padding: .75rem 1rem calc(.75rem + env(safe-area-inset-bottom));
      background: linear-gradient(to top, rgba(14, 17, 22, .96) 60%, rgba(14, 17, 22, 0));
      transform: translateY(110%); transition: transform .35s ease;
    }
    .mcta.show { transform: none; }
    .mcta .btn { width: 100%; padding: .8rem 1rem; font-size: 1rem; box-shadow: 0 10px 30px rgba(0, 0, 0, .45); }
    /* щоб кнопка не перекривала низ футера */
    :global(.footer) { padding-bottom: 80px; }
  }
  @media (prefers-reduced-motion: reduce) { .mcta { transition: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.mcta');
  const contact = document.getElementById('contact');
  let contactVisible = false;

  const update = () => {
    if (!bar) return;
    const show = window.scrollY > window.innerHeight * 0.8 && !contactVisible;
    bar.classList.toggle('show', show);
    bar.setAttribute('aria-hidden', String(!show));
    bar.querySelector('a')?.setAttribute('tabindex', show ? '0' : '-1');
  };

  if (contact && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      contactVisible = e.isIntersecting;
      update();
    }).observe(contact);
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
