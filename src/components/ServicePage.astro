---
// Сторінка послуги: /landing/, /business-card-website/, /multipage-website/ (і /ru/…, /en/…).
// Тексти: src/data/services/<послуга>.ts. Ціна, термін і назва тарифу: зі словника (t.services.items).
import Layout from '../layouts/Layout.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import ServiceArt from './ServiceArt.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { services, serviceUi, servicesFor } from '../data/services';
import { useT, localizePath } from '../i18n';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const { lang, t, home } = useT(Astro.currentLocale);
const def = services.find((s) => s.slug === slug);
const p = def?.text[lang];
if (!def || !p) throw new Error(`Немає тексту сторінки послуги "${slug}" мовою "${lang}"`);

const ui = serviceUi[lang];
const tariff = t.services.items[def.index];
const url = (path: string) => new URL(localizePath(lang, path), Astro.site ?? Astro.url).href;
const pageUrl = url(`/${slug}/`);

// приклади робіт: спільні дані проєкту + тексти поточною мовою
const works = def.works
  .map((id) => projects.find((pr) => pr.id === id))
  .filter((pr) => pr !== undefined)
  .map((pr) => ({ ...pr, ...t.portfolio.projects[pr.id] }));

// інші послуги: лише ті, що вже мають сторінку цією мовою
const others = servicesFor(lang)
  .filter((s) => s.slug !== slug)
  .map((s) => ({ href: localizePath(lang, `/${s.slug}/`), tariff: t.services.items[s.index], text: s.text[lang]! }));

const compareHref = p.compare && servicesFor(lang).some((s) => s.slug === p.compare!.link.slug)
  ? localizePath(lang, `/${p.compare.link.slug}/`)
  : null;

// Розмітка для Google: послуга з ціною, хлібні крихти та питання-відповіді
const priceValue = Number(tariff.price.replace(/\D/g, '')) || undefined;
const schema = [
  {
    '@type': 'Service',
    name: p.h1,
    description: p.metaDescription,
    url: pageUrl,
    serviceType: tariff.title,
    areaServed: lang === 'en' ? ['UA', 'US'] : 'UA',
    provider: { '@type': 'ProfessionalService', name: site.name, url: url('/'), telephone: site.phone },
    ...(priceValue && lang !== 'en' && {
      offers: { '@type': 'Offer', priceCurrency: 'UAH', price: priceValue, priceSpecification: { '@type': 'PriceSpecification', minPrice: priceValue, priceCurrency: 'UAH' } },
    }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: url('/') },
      { '@type': 'ListItem', position: 2, name: tariff.title, item: pageUrl },
    ],
  },
  {
    '@type': 'FAQPage',
    mainEntity: p.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const artProject = projects.find((pr) => pr.id === def.art);

const srcset = (img: string) => `${img.replace('/portfolio/', '/portfolio/sm/')} 700w, ${img} 1200w`;
---

<Layout title={p.metaTitle} description={p.metaDescription} schema={schema}>
  <main>
    <section class="intro band">
      <div class="container intro-grid">
        <div>
          <nav class="crumbs" aria-label="breadcrumbs">
            <a href={home}>{ui.home}</a> <span aria-hidden="true">/</span> <a href={`${home}#services`}>{ui.services}</a> <span aria-hidden="true">/</span> <span aria-current="page">{tariff.title}</span>
          </nav>
          <p class="eyebrow">{p.eyebrow}</p>
          <h1>{p.h1}</h1>
          <p class="text">{p.intro}</p>
          <div class="facts">
            <div><span class="label">{ui.price}</span><strong>{tariff.price}</strong></div>
            <div><span class="label">{ui.term}</span><strong>{tariff.term}</strong></div>
          </div>
          <div class="actions">
            <a class="btn" href="#contact">{ui.discuss}</a>
            <a class="btn btn--ghost" href={site.telegram} target="_blank" rel="noopener">{t.ui.telegramCta}</a>
          </div>
        </div>
        {artProject && (
          <ServiceArt
            id={artProject.id}
            domain={new URL(artProject.url).hostname}
            alt={`${artProject.title}: ${t.portfolio.projects[artProject.id]?.type ?? ''}`}
            lead={ui.artLead}
            now={ui.artNow}
            term={tariff.term}
          />
        )}
      </div>
    </section>

    <div class="band dots">
      <section class="section container about">
        <div>
          <h2>{p.about.title}</h2>
          {p.about.text.map((x) => <p class="para">{x}</p>)}
        </div>
        <ul class="who">{p.about.who.map((w, i) => <li data-reveal style={`--i:${i}`}><span class="tick" aria-hidden="true">✓</span>{w}</li>)}</ul>
      </section>
    </div>

    <div class="band band--soft lines">
      <section class="section container">
        <h2>{p.includes.title}</h2>
        <p class="lead">{p.includes.lead}</p>
        <div class="grid">
          {p.includes.items.map((it, i) => (
            <article class="item spot" data-reveal style={`--i:${i % 4}`}>
              <span class="ico"><Icon name={it.icon} /></span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </article>
          ))}
        </div>
      </section>
    </div>

    <div class="band band--yellow">
      <section class="section container">
        <h2>{p.steps.title}</h2>
        <p class="lead">{p.steps.lead}</p>
        <ol class="steps">
          {p.steps.items.map((s, i) => (
            <li data-reveal style={`--i:${i}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <div class="band band--grain glow">
      <section class="section container price">
        <div>
          <h2>{p.price.title}</h2>
          {p.price.text.map((x) => <p class="para">{x}</p>)}
          <p class="para small">{t.services.extras}</p>
        </div>
        <div class="price-card" data-reveal>
          <span class="label">{ui.price}</span>
          <strong class="big">{tariff.price}</strong>
          <span class="label">{ui.term}: <b>{tariff.term}</b></span>
          <ul>{p.price.factors.map((f) => <li>{f}</li>)}</ul>
          <a class="btn" href="#contact">{ui.discuss}</a>
        </div>
      </section>
    </div>

    {works.length > 0 && (
      <div class="band dots">
        <section class="section container">
          <h2>{ui.worksTitle}</h2>
          <p class="lead">{ui.worksLead}</p>
          <div class="works">
            {works.map((w, i) => (
              <a class="work spot" href={w.url} target="_blank" rel="noopener" data-reveal style={`--i:${i}`}>
                <div class="shot">
                  {w.image && <img src={w.image.replace('/portfolio/', '/portfolio/sm/')} srcset={srcset(w.image)} sizes="(max-width: 860px) calc(100vw - 32px), 380px" alt={`${w.title}: ${t.portfolio.screenshotAlt}`} loading="lazy" decoding="async" />}
                </div>
                <div class="work-body">
                  <p class="type">{w.short}</p>
                  <h3>{w.title} <span aria-hidden="true">↗</span></h3>
                  <p>{w.type}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      </div>
    )}

    {p.compare && (
      <div class="container">
        <section class="compare">
          <h2>{p.compare.title}</h2>
          <p>{p.compare.text}</p>
          {compareHref && <a class="link" href={compareHref}>{p.compare.link.label}</a>}
        </section>
      </div>
    )}

    <div class="band band--soft"><Faq items={p.faq} title={ui.faqTitle} lead={ui.faqLead} /></div>

    {others.length > 0 && (
      <div class="band lines">
        <section class="section container">
          <h2>{ui.otherTitle}</h2>
          <div class="others">
            {others.map((o) => (
              <a class="other spot" href={o.href}>
                <h3>{o.tariff.title}</h3>
                <p>{o.text.metaDescription}</p>
                <span class="row"><strong>{o.tariff.price}</strong><span class="link">{ui.more}</span></span>
              </a>
            ))}
          </div>
        </section>
      </div>
    )}

    <div class="band band--soft glow"><Contact title={p.cta.title} lead={p.cta.text} preset={tariff.title} /></div>
  </main>
</Layout>

<style>
  /* ---- фонові візерунки секцій ---- */
  /* сітка ліній, що згасає до країв */
  .lines::after, .intro::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .045) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 70%);
    mask-image: radial-gradient(ellipse at 50% 0%, #000 15%, transparent 70%);
  }
  /* крапки справа і жовте світіння зліва */
  .dots::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image: radial-gradient(rgba(255, 255, 255, .13) 1px, transparent 1.4px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 100% 50%, #000, transparent 75%);
    mask-image: radial-gradient(ellipse 60% 70% at 100% 50%, #000, transparent 75%);
  }
  .dots::after {
    content: ''; position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background: radial-gradient(600px 380px at 0% 30%, rgba(255, 210, 0, .07), transparent 70%);
  }
  /* синє й жовте світіння */
  .glow::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(700px 400px at 85% 20%, rgba(7, 117, 243, .14), transparent 65%),
      radial-gradient(500px 360px at 10% 90%, rgba(255, 210, 0, .08), transparent 65%);
  }

  /* ---- перший екран ---- */
  .intro { overflow: hidden; padding: clamp(2rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem); }
  .intro::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(900px 520px at 88% -6%, rgba(7, 117, 243, .24), transparent 62%),
      radial-gradient(700px 480px at 0% 22%, rgba(255, 210, 0, .12), transparent 60%);
  }
  .intro-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .crumbs { color: var(--muted); font-size: .85rem; margin-bottom: 1.75rem; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--accent); }
  .crumbs [aria-current] { color: var(--text); }
  h1 { font-size: clamp(2rem, 4.6vw, 3.5rem); line-height: 1.05; font-weight: 800; max-width: 16ch; margin-bottom: 1.25rem; }
  .text { color: var(--muted); font-size: 1.1rem; max-width: 58ch; margin-bottom: 1.75rem; }
  .facts {
    display: inline-flex; flex-wrap: wrap; gap: 1rem 2.5rem; margin-bottom: 2rem; padding: .9rem 1.4rem;
    border: 1px solid rgba(255, 210, 0, .3); border-radius: 14px; background: rgba(255, 210, 0, .05);
  }
  .facts strong { font-family: var(--font-head); font-size: clamp(1.15rem, 2.4vw, 1.5rem); color: var(--accent); }
  .label { display: block; color: var(--muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }

  .para { color: var(--muted); max-width: 62ch; }
  .para + .para { margin-top: 1rem; }
  .small { font-size: .92rem; }

  /* ---- кому підходить ---- */
  .about, .price { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .who { list-style: none; display: grid; gap: .75rem; }
  .who li {
    display: flex; align-items: center; gap: .9rem; padding: .9rem 1.1rem;
    background: rgba(22, 27, 34, .85); border: 1px solid var(--line); border-radius: 14px;
    transition: border-color .25s, transform .25s;
  }
  .who li:hover { border-color: rgba(255, 210, 0, .5); transform: translateX(4px); }
  .tick { display: grid; place-items: center; flex: none; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); color: #111; font-weight: 800; font-size: .85rem; }

  /* ---- що входить ---- */
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .item {
    padding: 1.5rem; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 18px;
    transition: transform .25s, border-color .25s;
  }
  .item:hover { transform: translateY(-4px); border-color: rgba(255, 210, 0, .45); }
  .ico {
    display: grid; place-items: center; width: 46px; height: 46px; margin-bottom: 1rem; border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), #ffb800); color: #111;
    box-shadow: 0 8px 24px rgba(255, 210, 0, .22);
  }
  .item h3 { font-size: 1.05rem; margin-bottom: .5rem; }
  .item p { color: var(--muted); font-size: .93rem; }

  /* ---- етапи на жовтому фоні ---- */
  .steps { list-style: none; display: grid; gap: 2rem 1.75rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .steps li { position: relative; padding-top: 1.4rem; border-top: 3px solid #111; }
  .steps li::before { content: ''; position: absolute; top: -9px; left: 0; width: 15px; height: 15px; border-radius: 50%; background: #111; }
  .num {
    display: block; margin-bottom: .8rem; font-family: var(--font-head); font-weight: 800; line-height: 1;
    font-size: clamp(2.8rem, 5.5vw, 4.2rem); color: transparent; -webkit-text-stroke: 2px #111;
  }
  .steps h3 { font-size: 1.1rem; margin-bottom: .4rem; }
  .steps p { color: var(--muted); font-size: .95rem; }

  /* ---- ціна ---- */
  .price { align-items: center; }
  .price-card {
    position: relative; display: grid; gap: .6rem; padding: clamp(1.5rem, 3vw, 2.2rem); border-radius: 22px;
    background: linear-gradient(160deg, #1b222c, #10151c); border: 1px solid rgba(255, 210, 0, .45);
    box-shadow: 0 30px 80px rgba(0, 0, 0, .45), 12px 12px 0 var(--accent);
  }
  .big { font-family: var(--font-head); font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.1; color: var(--accent); }
  .price-card b { color: var(--text); }
  .price-card ul { list-style: none; display: grid; gap: .45rem; margin: .8rem 0 1rem; padding-top: 1rem; border-top: 1px dashed rgba(255, 255, 255, .18); }
  .price-card li { position: relative; padding-left: 1.4rem; font-size: .93rem; color: var(--muted); }
  .price-card li::before { content: '+'; position: absolute; left: 0; color: var(--accent); font-weight: 800; }

  /* ---- роботи ---- */
  .works { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .work { display: block; text-decoration: none; overflow: hidden; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 18px; transition: border-color .25s, transform .25s, box-shadow .25s; }
  .work:hover { border-color: rgba(255, 210, 0, .55); transform: translateY(-4px); box-shadow: 0 24px 60px rgba(0, 0, 0, .45); }
  .shot { aspect-ratio: 16 / 10; overflow: hidden; background: #0b0e13; }
  .shot img { width: 100%; height: auto; transition: transform 6s cubic-bezier(.45, .05, .3, 1); }
  .work:hover .shot img { transform: translateY(-30%); }
  .work-body { padding: 1rem 1.2rem 1.3rem; }
  .type { color: var(--accent); font-weight: 700; font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; }
  .work h3 { font-size: 1.15rem; margin: .3rem 0; }
  .work-body p:last-child { color: var(--muted); font-size: .9rem; }

  /* ---- порівняння ---- */
  .compare {
    position: relative; overflow: hidden; margin-block: clamp(3rem, 7vw, 5rem); padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 24px; border: 1px solid rgba(255, 210, 0, .35);
    background: radial-gradient(500px 260px at 100% 0%, rgba(255, 210, 0, .14), transparent 70%), linear-gradient(135deg, #18202b, #11161d);
  }
  .compare::after { content: '?'; position: absolute; right: 2rem; bottom: -2.5rem; font-family: var(--font-head); font-weight: 800; font-size: 11rem; line-height: 1; color: rgba(255, 210, 0, .08); pointer-events: none; }
  .compare h2 { font-size: clamp(1.3rem, 2.8vw, 1.8rem); }
  .compare p { position: relative; color: var(--muted); max-width: 70ch; margin-bottom: 1rem; }
  .link { position: relative; color: var(--accent); font-weight: 700; text-decoration: none; }
  .link:hover { text-decoration: underline; }

  /* ---- інші послуги ---- */
  .others { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .other { display: flex; flex-direction: column; gap: .6rem; padding: 1.6rem; text-decoration: none; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 18px; border-top: 3px solid var(--accent); transition: transform .25s, border-color .25s; }
  .other:hover { transform: translateY(-4px); border-color: rgba(255, 210, 0, .55); }
  .other p { color: var(--muted); font-size: .92rem; }
  .row { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 860px) {
    .about, .price { grid-template-columns: 1fr; }
    .price-card { box-shadow: 0 30px 80px rgba(0, 0, 0, .45), 8px 8px 0 var(--accent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .work:hover .shot img { transform: none; }
  }
</style>
