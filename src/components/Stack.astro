---
import { stack } from '../data/content';
import { useT } from '../i18n';

const { t } = useT(Astro.currentLocale);
const row = [...stack, ...stack];
---

<div class="marquee" role="region" aria-label={t.stackLabel}>
  <div class="track">
    {row.map((s, i) => (
      <span aria-hidden={i >= stack.length ? 'true' : undefined}>{s}<i>✦</i></span>
    ))}
  </div>
</div>

<style>
  .marquee { overflow: hidden; background: var(--bg-deep); border-block: 1px solid var(--line); }
  .track { display: flex; width: max-content; animation: run 34s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  span {
    display: inline-flex; align-items: center; gap: 2.5rem; padding: 1rem 0 1rem 2.5rem;
    font-family: var(--font-head); font-size: .8rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted);
  }
  i { color: var(--accent); font-style: normal; }
  @keyframes run { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
</style>