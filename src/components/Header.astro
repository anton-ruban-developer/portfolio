---
import { site } from '../data/site';
import { useT, locales, langMeta, stripLocale, localizePath } from '../i18n';
import { servicesFor } from '../data/services';
import { primaryCta } from '../data/cta';

const { lang, t, home } = useT(Astro.currentLocale);
const cta = primaryCta(lang, t);

// сторінки послуг (підменю «Послуги»): лише ті, що вже є цією мовою
const current = Astro.url.pathname.replace(/\/?$/, '/');
const serviceLinks = servicesFor(lang).map((s) => {
  const href = localizePath(lang, `/${s.slug}/`);
  return { href, label: t.services.items[s.index].title, price: t.services.items[s.index].price, active: href === current };
});

const links: { href: string; label: string; sub?: typeof serviceLinks }[] = [
  { href: `${home}#services`, label: t.nav.services, sub: serviceLinks },
  { href: localizePath(lang, '/works/'), label: t.nav.portfolio },
  { href: `${home}#process`, label: t.nav.process },
  { href: `${home}#why`, label: t.nav.why },
  { href: `${home}#faq`, label: t.nav.faq },
  { href: localizePath(lang, '/contacts/'), label: t.nav.contact },
];

// перемикач мов: посилання на цю ж сторінку іншою мовою
const pagePath = stripLocale(Astro.url.pathname);
const langs = locales.map((l) => ({ code: l, href: localizePath(l, pagePath), ...langMeta[l] }));
---

<header class="header">
  <div class="container bar">
    <a class="logo" href={home} aria-label={`${site.name}: ${t.ui.toHome}`}>
      {site.logo
        ? <img src={site.logo} alt={site.name} width="167" height="40" loading="eager" fetchpriority="high" decoding="async" />
        : <span class="logo-text">{site.name}</span>}
    </a>

    <nav id="menu" class="menu">
      <ul class="main">
        {links.map((l, i) => (
          <li style={`--i:${i}`} class:list={{ 'has-sub': l.sub?.length }}>
            <a href={l.href} aria-current={l.href === current ? 'page' : l.sub?.some((s) => s.active) ? 'true' : undefined}>{l.label}</a>
            {l.sub && l.sub.length > 0 && (
              <ul class="sub">
                {l.sub.map((s) => (
                  <li><a href={s.href} aria-current={s.active ? 'page' : undefined}><span>{s.label}</span><small>{s.price}</small></a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <!-- низ меню на телефоні: статус і контакти (на десктопі прихований) -->
      <div class="menu-foot" style={`--i:${links.length}`}>
        <span class="menu-status"><i></i> {t.ui.acceptingProjects}</span>
        <a class="menu-phone" href={`tel:${site.phone}`}>{site.phoneLabel}</a>
      </div>
      <a class="btn" href={cta.href} target={cta.external ? '_blank' : undefined} rel={cta.external ? 'noopener' : undefined} style={`--i:${links.length + 1}`}>{cta.label}</a>
    </nav>

    <nav class="langs" aria-label={t.ui.language}>
      {langs.map((l) => (
        <a
          href={l.href}
          hreflang={l.code}
          lang={l.code}
          title={l.name}
          aria-label={l.name}
          aria-current={l.code === lang ? 'page' : undefined}
        >{l.label}</a>
      ))}
    </nav>

    <button class="burger" aria-label={t.ui.openMenu} aria-expanded="false" aria-controls="menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(14, 17, 22, .85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, .08);
  }
  /* розмиття фону дороге під час прокрутки: на слабких пристроях суцільний фон */
  :global(.lite) .header { backdrop-filter: none; background: rgb(14, 17, 22); }
  .bar { display: flex; align-items: center; gap: 1rem; min-height: 68px; }

  .logo { display: inline-flex; align-items: center; text-decoration: none; }
  .logo img { width: auto; height: 40px; }
  .logo-text { font-family: var(--font-head); font-weight: 800; font-size: 1.15rem; color: var(--accent); }

  .menu { display: flex; align-items: center; gap: 1.5rem; margin-left: auto; }
  .menu ul { list-style: none; }
  .main { display: flex; gap: 1.25rem; }
  .main > li > a { color: var(--muted); text-decoration: none; transition: color .2s; white-space: nowrap; }
  .main > li > a:hover, .main > li > a[aria-current] { color: var(--text); }

  /* підменю «Послуги»: випадає при наведенні або фокусі */
  .has-sub { position: relative; }
  .has-sub > a::after { content: '▾'; margin-left: .3rem; font-size: .75em; color: var(--accent); }
  .sub {
    position: absolute; top: 100%; left: -1rem; min-width: 290px; margin-top: .9rem; padding: .5rem;
    display: grid; gap: .15rem;
    background: #161b22; border: 1px solid rgba(255, 255, 255, .12); border-radius: 14px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, .5);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .2s, transform .2s, visibility 0s linear .2s;
  }
  /* невидимий «місток», щоб меню не закривалось, поки курсор іде вниз */
  .sub::before { content: ''; position: absolute; left: 0; right: 0; top: -1rem; height: 1rem; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; transition: opacity .2s, transform .2s; }
  .sub a {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .65rem .8rem; border-radius: 10px;
    color: var(--text); text-decoration: none; white-space: nowrap; transition: background .2s;
  }
  .sub a:hover, .sub a[aria-current] { background: rgba(255, 210, 0, .1); }
  .sub a[aria-current] span { color: var(--accent); }
  .sub small { color: var(--muted); font-size: .8rem; }
  .burger {
    display: none; width: 44px; height: 44px; background: none; border: 0; cursor: pointer;
    flex-direction: column; justify-content: center; align-items: center; gap: 5px;
  }
  .burger span { width: 24px; height: 2px; background: var(--text); border-radius: 2px; }
  .menu .btn { padding: .4rem .9rem; font-size: .85rem; border-radius: 10px; white-space: nowrap; }

  /* перемикач мов */
  .langs {
    display: flex; flex-shrink: 0; padding: 3px; gap: 2px;
    border: 1px solid rgba(255, 255, 255, .14); border-radius: 999px;
  }
  .langs a {
    display: grid; place-items: center; min-width: 34px; height: 28px; padding: 0 .45rem; border-radius: 999px;
    font-size: .75rem; font-weight: 700; letter-spacing: .06em; color: var(--muted); text-decoration: none;
    transition: color .2s, background .2s;
  }
  .langs a:hover { color: var(--text); }
  .langs a[aria-current='page'] { background: var(--accent); color: #111; }
  .langs a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .menu-foot { display: none; }

  /* ---- Мобільне меню на весь екран ---- */
  @media (max-width: 1160px) {
    .burger { display: flex; position: relative; }
    .burger span { transition: transform .25s cubic-bezier(.7, 0, .2, 1), opacity .15s; }
    /* три смужки → хрестик */
    .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; transform: scaleX(0); }
    .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .langs { margin-left: auto; }
    .langs a { height: 32px; min-width: 38px; }

    /* панель під рядком шапки (z-index -1 всередині шапки), тому логотип, мови і хрестик лишаються зверху */
    .menu {
      position: absolute; z-index: -1; top: 0; left: 0; right: 0; height: 100vh; height: 100dvh; margin-left: 0;
      display: flex; flex-direction: column; align-items: stretch; gap: 1.5rem;
      padding: calc(68px + clamp(1.5rem, 6vh, 3rem)) max(1rem, calc((100% - var(--max)) / 2)) calc(1.5rem + env(safe-area-inset-bottom));
      overflow-y: auto; overscroll-behavior: contain;
      background:
        radial-gradient(600px 400px at 100% 0%, rgba(255, 210, 0, .14), transparent 70%),
        linear-gradient(rgba(255, 255, 255, .03) 1px, transparent 1px) 0 0 / 56px 56px,
        linear-gradient(90deg, rgba(255, 255, 255, .03) 1px, transparent 1px) 0 0 / 56px 56px,
        var(--bg-deep);
      /* розкривається колом від бургера */
      clip-path: circle(0 at calc(100% - 38px) 34px);
      visibility: hidden;
      transition: clip-path .4s cubic-bezier(.7, 0, .2, 1), visibility 0s linear .4s;
    }
    .menu.open {
      clip-path: circle(150% at calc(100% - 38px) 34px);
      visibility: visible;
      transition: clip-path .45s cubic-bezier(.7, 0, .2, 1), visibility 0s;
    }

    .main { flex-direction: column; gap: 0; counter-reset: m; }
    .main > li { counter-increment: m; border-bottom: 1px solid rgba(255, 255, 255, .08); }
    .main > li > a {
      display: flex; align-items: baseline; gap: 1rem; padding: .7rem 0;
      font-family: var(--font-head); font-weight: 700; letter-spacing: -.02em;
      font-size: clamp(1.6rem, 7vw, 2.6rem); line-height: 1.15; color: var(--text);
      transition: color .2s, transform .3s;
    }
    .main > li > a::before {
      content: counter(m, decimal-leading-zero); font-family: var(--font-body);
      font-size: .8rem; font-weight: 700; letter-spacing: .1em; color: var(--accent);
    }
    .main > li > a:hover, .main > li > a:focus-visible { color: var(--accent); transform: translateX(8px); }
    .has-sub > a::after { content: none; }

    /* на телефоні підменю завжди відкрите: послуги «таблетками» під пунктом */
    .sub {
      position: static; min-width: 0; margin: 0 0 .9rem; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem;
      background: none; border: 0; box-shadow: none; opacity: 1; visibility: visible; transform: none; transition: none;
    }
    .sub::before { content: none; }
    .sub a { padding: .45rem .85rem; border: 1px solid rgba(255, 255, 255, .16); border-radius: 999px; font-size: .9rem; font-weight: 600; }
    .sub small { display: none; }

    /* пункти виїжджають знизу по черзі */
    .main > li, .menu-foot, .menu .btn {
      opacity: 0; transform: translateY(24px);
      transition: opacity .2s, transform .2s;
    }
    .menu.open .main > li, .menu.open .menu-foot, .menu.open .btn {
      opacity: 1; transform: none;
      transition: opacity .35s ease, transform .4s cubic-bezier(.2, .8, .2, 1);
      transition-delay: calc(.15s + var(--i, 0) * 40ms);
    }

    .menu-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 1rem; margin-top: auto; }
    .menu-status {
      display: inline-flex; align-items: center; gap: .6rem; padding: .45rem .9rem; border-radius: 999px;
      border: 1px solid rgba(40, 200, 64, .35); background: rgba(40, 200, 64, .08); font-size: .85rem; font-weight: 600;
    }
    .menu-status i { width: 8px; height: 8px; border-radius: 50%; background: #28c840; animation: menu-pulse 2s infinite; }
    @keyframes menu-pulse { to { box-shadow: 0 0 0 8px rgba(40, 200, 64, 0); } }
    .menu-phone { color: var(--muted); text-decoration: none; font-weight: 600; }
    .menu-phone:hover { color: var(--accent); }
    .menu .btn { justify-content: center; padding: .9rem 1rem; font-size: 1rem; }

    /* поки меню відкрите, шапка без розмиття і без рамки, щоб зливалася з меню */
    .header:has(.menu.open) { background: transparent; backdrop-filter: none; border-bottom-color: transparent; }
  }

  @media (max-width: 1160px) and (prefers-reduced-motion: reduce) {
    .menu, .menu.open, .main > li, .menu-foot, .menu .btn, .burger span { transition: none !important; }
    .menu-status i { animation: none; }
  }
  /* вузький телефон: логотип менший, щоб поруч помістились мови та бургер */
  @media (max-width: 420px) {
    .logo img { height: 32px; }
    .bar { gap: .5rem; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('menu');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
    // поки меню на весь екран відкрите, сторінка під ним не прокручується
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => setOpen(!menu?.classList.contains('open')));

  // закриваємо меню після кліку по пункту та клавішею Escape (фокус повертаємо на бургер)
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('open')) {
      setOpen(false);
      btn?.focus();
    }
  });

  // повернули телефон або розширили вікно до десктопа: скидаємо відкрите меню
  window.matchMedia('(min-width: 1161px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
