---
import { projects } from '../data/projects';

const real = projects.filter((p) => p.image).slice(0, 3).map((p) => ({ img: p.image, name: p.title }));
const frames = [...real, ...Array.from({ length: 3 - real.length }, () => ({ img: '', name: '' }))];
---

<div class="shots" aria-hidden="true">
  {frames.map((f, i) => (
    <div class={`frame f${i}`}>
      <div class="bar"><i></i><i></i><i></i><span>{f.name}</span></div>
      <div class="view">
        {f.img
          ? <img src={f.img} alt="" loading="eager" decoding="async" />
          : <div class="skel"><b></b><b></b><b></b></div>}
      </div>
    </div>
  ))}
  <div class="chip"><i></i> Реальна робота</div>
</div>

<style>
  .shots { position: relative; width: 100%; max-width: 560px; margin-inline: auto; aspect-ratio: 1 / .88; }
  .frame {
    position: absolute; width: 76%; border-radius: 14px; overflow: hidden;
    background: #11161d; border: 1px solid rgba(255, 255, 255, .14);
    box-shadow: 0 30px 70px rgba(0, 0, 0, .5);
  }
  .f0 { left: 0; bottom: 0; z-index: 3; }
  .f1 { right: 0; top: 14%; z-index: 2; transform: scale(.94); opacity: .92; }
  .f2 { right: 7%; top: 0; z-index: 1; transform: scale(.87); opacity: .75; }

  .bar { display: flex; align-items: center; gap: .35rem; padding: .55rem .8rem; border-bottom: 1px solid rgba(255, 255, 255, .08); }
  .bar i { width: 8px; height: 8px; border-radius: 50%; background: rgba(255, 255, 255, .25); }
  .bar span { margin-left: .5rem; font: .65rem ui-monospace, Consolas, monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }

  .view { position: relative; overflow: hidden; aspect-ratio: 16 / 10; container-type: size; background: #0b0e13; }
  .view img { position: absolute; top: 0; left: 0; width: 100%; height: auto; }
  .f0 .view img { animation: pan 18s ease-in-out infinite alternate; }
  @keyframes pan { to { transform: translateY(min(0px, calc(100cqh - 100%))); } }

  .skel { display: grid; gap: .6rem; padding: 1rem; }
  .skel b { height: 10px; border-radius: 6px; background: rgba(255, 255, 255, .1); }
  .skel b:first-child { width: 55%; height: 16px; background: rgba(255, 210, 0, .35); }
  .skel b:nth-child(2) { width: 90%; }
  .skel b:nth-child(3) { width: 70%; }

  .chip {
    position: absolute; z-index: 4; right: 2%; bottom: 8%; display: flex; align-items: center; gap: .5rem;
    padding: .5rem .9rem; border-radius: 999px; font-size: .8rem; font-weight: 700;
    background: rgba(22, 27, 34, .96); border: 1px solid rgba(255, 255, 255, .14);
    box-shadow: 0 12px 30px rgba(0, 0, 0, .4);
  }
  .chip i { width: 8px; height: 8px; border-radius: 50%; background: #28c840; box-shadow: 0 0 0 0 rgba(40, 200, 64, .6); animation: pulse 2s infinite; }
  @keyframes pulse { to { box-shadow: 0 0 0 10px rgba(40, 200, 64, 0); } }

  @media (prefers-reduced-motion: reduce) {
    .f0 .view img, .chip i { animation: none; }
  }
</style>