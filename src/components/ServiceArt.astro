---
// Ілюстрація першого екрана сторінки послуги: справжній сайт клієнта в браузері й на телефоні
// та сповіщення про заявку. Картинки: public/portfolio/art/<id>-desk.webp і <id>-mob.webp
// (скріншот першого екрана для комп'ютера 880px і мобільної версії 360px).
interface Props {
  /** id проєкту з src/data/projects.ts */
  id: string;
  /** адреса сайту, яка показується в рядку браузера */
  domain: string;
  alt: string;
  lead: string;
  now: string;
  term: string;
}
const { id, domain, alt, lead, now, term } = Astro.props;
---

<div class="art">
  <div class="browser">
    <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>{domain}</span></div>
    <img src={`/portfolio/art/${id}-desk.webp`} alt={alt} width="880" height="550" loading="eager" fetchpriority="high" decoding="async" />
  </div>

  <div class="phone" aria-hidden="true">
    <img src={`/portfolio/art/${id}-mob.webp`} alt="" width="360" height="720" loading="eager" decoding="async" />
  </div>

  <div class="toast" aria-hidden="true">
    <span class="tg">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M21.9 4.3 18.7 19.4c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.3-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.2 13 1.4 11.5c-1-.3-1-1 .2-1.5L20.6 2.9c.9-.3 1.6.2 1.3 1.4z"/></svg>
    </span>
    <span class="t"><strong>{lead}</strong><small>{now}</small></span>
  </div>

  <div class="chip" aria-hidden="true"><span>⚡</span> {term}</div>
</div>

<style>
  .art { position: relative; width: 100%; max-width: 560px; margin-inline: auto; aspect-ratio: 1 / .78; }

  /* браузер зі скріншотом */
  .browser {
    position: absolute; left: 0; top: 7%; width: 88%; border-radius: 14px; overflow: hidden;
    background: #11161d; border: 1px solid rgba(255, 255, 255, .16);
    box-shadow: 0 30px 80px rgba(0, 0, 0, .55);
  }
  .bar { display: flex; align-items: center; gap: .35rem; padding: .5rem .8rem; border-bottom: 1px solid rgba(255, 255, 255, .08); }
  .bar i { width: 9px; height: 9px; border-radius: 50%; background: #ff5f57; flex: none; }
  .bar i:nth-child(2) { background: #febc2e; }
  .bar i:nth-child(3) { background: #28c840; }
  .bar span {
    flex: 1; min-width: 0; margin-left: .6rem; padding: .15rem .8rem; border-radius: 999px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    background: rgba(255, 255, 255, .07); color: var(--muted); font: .7rem ui-monospace, Consolas, monospace; text-align: center;
  }
  .browser img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }

  /* телефон з мобільною версією */
  .phone {
    position: absolute; right: 0; bottom: 0; width: 31%; padding: 6px; border-radius: 26px;
    background: #05070a; border: 2px solid rgba(255, 255, 255, .22);
    box-shadow: 0 25px 60px rgba(0, 0, 0, .65), 0 0 0 6px rgba(255, 255, 255, .03);
  }
  .phone::before {
    content: ''; position: absolute; z-index: 1; top: 12px; left: 50%; translate: -50% 0;
    width: 28%; height: 8px; border-radius: 999px; background: #05070a;
  }
  .phone img { width: 100%; height: auto; aspect-ratio: 1 / 2; object-fit: cover; object-position: top; border-radius: 20px; }

  /* сповіщення про нову заявку */
  .toast {
    position: absolute; left: 5%; bottom: 3%; display: flex; align-items: center; gap: .7rem;
    padding: .7rem 1.1rem .7rem .7rem; border-radius: 14px;
    background: rgba(22, 27, 34, .96); border: 1px solid rgba(255, 255, 255, .16);
    box-shadow: 0 18px 50px rgba(0, 0, 0, .6);
  }
  .tg { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #2aabee; color: #fff; flex: none; }
  .t { display: grid; line-height: 1.25; }
  .t strong { font-size: .82rem; }
  .t small { color: var(--muted); font-size: .72rem; }

  .chip {
    position: absolute; right: 24%; top: 0; display: inline-flex; align-items: center; gap: .4rem;
    padding: .4rem .85rem; border-radius: 999px; font-size: .8rem; font-weight: 800;
    background: var(--accent); color: #111; box-shadow: 0 10px 30px rgba(255, 210, 0, .35);
  }

  @media (max-width: 480px) {
    .toast { padding: .5rem .75rem .5rem .5rem; }
    .tg { width: 28px; height: 28px; }
    .phone { padding: 4px; border-radius: 18px; }
    .phone img { border-radius: 14px; }
  }
</style>
