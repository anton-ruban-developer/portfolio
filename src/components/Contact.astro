---
import { site, emailEncoded, emailMasked } from '../data/site';
import { useT, localizePath } from '../i18n';

const { lang, t } = useT(Astro.currentLocale);
const privacyHref = localizePath(lang, '/privacy/');
const f = t.contact.form;
---

<section class="section container" id="contact">
  <div class="wrap" class:list={{ solo: !site.formKey }}>
    <div class="info">
      <h2>{t.contact.title}</h2>
      <p class="lead">{t.contact.lead}</p>

      <ul class="links">
        <li>
          <a href={site.telegram} target="_blank" rel="noopener">
            <span class="k">Telegram</span><strong>{site.telegramHandle}</strong><i>→</i>
          </a>
        </li>
        <li>
          <a href={`tel:${site.phone}`}>
            <span class="k">{t.contact.phone}</span><strong>{site.phoneLabel}</strong><i>→</i>
          </a>
        </li>
        <li>
          <a href="#contact" data-email={emailEncoded}>
            <span class="k">Email</span><strong data-email-text>{emailMasked}</strong><i>→</i>
          </a>
        </li>
      </ul>
    </div>

    {site.formKey && (
      <form
        id="lead-form" class="form" novalidate
        data-sending={f.sending} data-wait={f.wait} data-success={f.success} data-error={f.error} data-network={f.network}
      >
        <input type="hidden" name="access_key" value={site.formKey} />
        <input type="hidden" name="subject" value={f.subject} />
        <input type="hidden" name="from_name" value={`Сайт ${site.name}`} />
        <input type="checkbox" name="botcheck" class="trap" tabindex="-1" autocomplete="off" />

        <label>
          {f.name}
          <input type="text" name="name" required maxlength="80" autocomplete="name" placeholder={f.namePh} />
        </label>

        <label>
          {f.contact}
          <input
            type="text" name="contact" required maxlength="64" placeholder={f.contactPh} title={f.contactHint}
            pattern="\s*(@?[A-Za-z0-9_]{4,32}|\+?[0-9\s\(\)\-]{9,20}|[^\s@]+@[^\s@]+\.[^\s@]+)\s*"
          />
        </label>

        <label>
          {f.project}
          <select name="project">
            {t.services.items.map((s) => <option value={s.title}>{s.title}</option>)}
            <option value={f.other}>{f.other}</option>
          </select>
        </label>

        <label>
          {f.message}
          <textarea name="message" rows="4" maxlength="2000" placeholder={f.messagePh}></textarea>
        </label>

        <button class="btn" type="submit">{f.submit}</button>
        <p id="lead-status" class="status" role="status" aria-live="polite"></p>
        <p class="note">{f.consent} <a href={privacyHref}>{f.privacyLink}</a></p>
      </form>
    )}
  </div>
</section>

<style>
  .wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: start; }
  .wrap.solo { grid-template-columns: 1fr; max-width: 640px; }
  .lead { color: var(--muted); margin-bottom: 1.75rem; max-width: 46ch; }

  .links { list-style: none; display: grid; gap: .75rem; }
  .links a {
    display: grid; grid-template-columns: 1fr auto; gap: .1rem 1rem; align-items: center;
    padding: 1rem 1.25rem; text-decoration: none;
    background: var(--bg-soft); border: 1px solid rgba(255, 255, 255, .08); border-radius: 14px;
    transition: border-color .2s, transform .2s;
  }
  .links a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .k { grid-column: 1; color: var(--muted); font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; }
  .links strong { grid-column: 1; font-size: 1.1rem; }
  .links i { grid-column: 2; grid-row: 1 / span 2; color: var(--accent); font-style: normal; font-size: 1.4rem; }

  .form {
    display: grid; gap: 1rem; padding: 1.75rem;
    background: var(--bg-soft); border: 1px solid rgba(255, 255, 255, .08); border-radius: var(--radius);
  }
  .form label { display: grid; gap: .4rem; font-size: .9rem; color: var(--muted); }
  .form input, .form select, .form textarea {
    width: 100%; padding: .8rem 1rem; font: inherit; color: var(--text);
    background: var(--bg); border: 1px solid rgba(255, 255, 255, .14); border-radius: 10px;
  }
  .form textarea { resize: vertical; }
  .form input:focus, .form select:focus, .form textarea:focus {
    outline: 2px solid var(--accent); outline-offset: 1px; border-color: transparent;
  }
  .form :invalid:not(:placeholder-shown):not(:focus) { border-color: #ff6b6b; }
  .trap { position: absolute; left: -9999px; opacity: 0; }
  .form .btn { justify-content: center; cursor: pointer; }
  .form .btn:disabled { opacity: .6; cursor: wait; }
  .status { min-height: 1.4em; font-weight: 600; }
  .status.ok { color: #28c840; }
  .status.err { color: #ff6b6b; }
  .note { color: var(--muted); font-size: .8rem; }
  .note a { color: var(--text); }

  @media (max-width: 800px) {
    .wrap { grid-template-columns: 1fr; }
    .form { padding: 1.25rem; }
  }
</style>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const status = document.getElementById('lead-status');

  // тексти статусу беремо з data-атрибутів форми: вони вже потрібною мовою
  const msg = (key: string) => form?.dataset[key] ?? '';

  const show = (text: string, kind: '' | 'ok' | 'err') => {
    if (!status) return;
    status.textContent = text;
    status.className = `status ${kind}`;
  };

  // Захист від ботів (разом із прихованим полем botcheck, яке перевіряє і сам Web3Forms):
  // боти заповнюють форму миттєво й відправляють її багато разів поспіль.
  const MIN_FILL_MS = 3000; // людина не встигне заповнити форму швидше
  const COOLDOWN_MS = 60_000; // пауза між заявками з одного браузера
  const COOLDOWN_KEY = 'lead-sent-at';
  const openedAt = Date.now();

  const lastSent = () => {
    try { return Number(localStorage.getItem(COOLDOWN_KEY)) || 0; } catch { return 0; }
  };
  const markSent = () => {
    try { localStorage.setItem(COOLDOWN_KEY, String(Date.now())); } catch { /* приватний режим */ }
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // бот: заповнив пастку або впорався надто швидко. Показуємо «успіх», але нічого не відправляємо
    const trap = form.querySelector<HTMLInputElement>('input[name="botcheck"]');
    if (trap?.checked || Date.now() - openedAt < MIN_FILL_MS) {
      form.reset();
      show(msg('success'), 'ok');
      return;
    }
    if (Date.now() - lastSent() < COOLDOWN_MS) {
      show(msg('wait'), 'err');
      return;
    }

    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (btn) btn.disabled = true;
    show(msg('sending'), '');

    try {
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      for (const k of ['name', 'contact', 'message']) data[k] = (data[k] ?? '').trim();
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (res.ok && json.success) {
        form.reset();
        markSent();
        show(msg('success'), 'ok');
        (window as any).gtag?.('event', 'generate_lead', { form: 'contact' });
      } else {
        show(msg('error'), 'err');
      }
    } catch {
      show(msg('network'), 'err');
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>