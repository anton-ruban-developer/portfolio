---
import { site } from '../data/site';
import { useT } from '../i18n';
import HeroShots from './HeroShots.astro';

const { t } = useT(Astro.currentLocale);

// Заголовок по словах: кожне слово виїжджає знизу по черзі
const { lead, accent } = t.hero;

// Цифри, які можна «відрахувати»: 25+ → 25 і «+». Діапазони на кшталт 3–5 лишаються як є.
const parsed = t.stats.map((s) => {
  const m = s.value.match(/^(\d+)(\D*)$/);
  return { ...s, to: m ? Number(m[1]) : null, suffix: m ? m[2] : '' };
});
---

<section class="hero band">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>
        {lead.map((w, i) => <><span class="w"><span style={`--w:${i}`}>{w}</span></span>{' '}</>)}
        <span class="hl">{accent.map((w, i) => <><span class="w"><span style={`--w:${lead.length + i}`}>{w}</span></span>{i < accent.length - 1 && ' '}</>)}</span>
      </h1>
      <p class="lead">{t.hero.text}</p>
      <div class="actions">
        <a class="btn" href={site.telegram} target="_blank" rel="noopener">{t.ui.telegramCta}</a>
        <a class="btn btn--ghost" href="#portfolio">{t.hero.viewWork}</a>
      </div>
    </div>
    <HeroShots />
  </div>

  <div class="container stats">
    {parsed.map((s, i) => (
      <div class="stat">
        <strong>
          {s.to !== null
            ? <><span class="count" data-to={s.to}>{s.to}</span>{s.suffix}</>
            : s.value}
          {s.unit && <small>{s.unit}</small>}
        </strong>
        <span>{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero { overflow: hidden; padding-top: clamp(2.5rem, 7vw, 5rem); }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(900px 520px at 88% -6%, rgba(7, 117, 243, .22), transparent 62%),
      radial-gradient(700px 480px at 0% 22%, rgba(255, 210, 0, .12), transparent 60%);
  }
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, .04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .04) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse at 50% 0%, #000 10%, transparent 70%);
  }
  .grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 3rem; align-items: center; }
  h1 { font-size: clamp(1.9rem, 4.1vw, 3.3rem); line-height: 1.05; margin-bottom: 1.25rem; font-weight: 800; }
  .hl {
    color: var(--accent);
    /* маркер під акцентними словами: промальовується після появи заголовка */
    background: linear-gradient(rgba(255, 210, 0, .2), rgba(255, 210, 0, .2)) no-repeat 0 88% / 0% .38em;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
    animation: mark .9s cubic-bezier(.6, 0, .2, 1) 1s forwards;
  }
  .w { display: inline-block; overflow: hidden; vertical-align: bottom; padding-bottom: .1em; margin-bottom: -.1em; }
  .w > span { display: inline-block; }
  :global(.js) .w > span { transform: translateY(110%); animation: rise .8s cubic-bezier(.2, .7, .2, 1) forwards; animation-delay: calc(.15s + var(--w) * .1s); }
  @keyframes rise { to { transform: none; } }
  @keyframes mark { to { background-size: 100% .38em; } }
  .count { font-variant-numeric: tabular-nums; }
  .lead { margin-bottom: 2rem; font-size: 1.15rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; }

  .stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
    margin-top: clamp(2.5rem, 6vw, 4rem); margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
    border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--line);
  }
  .stat { background: var(--bg); padding: 1.2rem 1.5rem; }
  .stat strong { display: block; font-family: var(--font-head); font-size: clamp(1.4rem, 2.8vw, 2rem); color: var(--accent); }
  .stat small { margin-left: .35rem; font-size: .5em; color: var(--text); }
  .stat > span { color: var(--muted); font-size: .9rem; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  /* на телефоні дві кнопки в один ряд, трохи менші */
  @media (max-width: 560px) {
    .actions { flex-wrap: nowrap; gap: .5rem; }
    .actions .btn { flex: 1 1 0; min-width: 0; padding: .6rem .7rem; font-size: .85rem; text-align: center; line-height: 1.25; }
  }
  /* на планшеті й телефоні статистика сіткою 2×2, підписи дрібніші */
  @media (max-width: 1000px) {
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat { padding: 1rem 1.1rem; }
    .stat > span { font-size: .82rem; line-height: 1.4; display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .w > span { animation: none; transform: none; }
    .hl { animation: none; background-size: 100% .38em; }
  }
</style>

<script>
  // відлік цифр від нуля, коли блок зі статистикою з'являється на екрані
  const counters = document.querySelectorAll<HTMLElement>('.count[data-to]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const run = (el: HTMLElement) => {
    const to = Number(el.dataset.to);
    const dur = 1400;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min((now - start) / dur, 1);
      el.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          run(e.target as HTMLElement);
          io.unobserve(e.target);
        }),
      { threshold: 0.6 }
    );
    counters.forEach((el) => {
      el.textContent = '0';
      io.observe(el);
    });
  }
</script>