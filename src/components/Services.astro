---
import { services } from '../data/services';
---

<section class="section container" id="services">
  <p class="eyebrow">Послуги та вартість</p>
  <h2>Оберіть формат проєкту</h2>
  <p class="lead">Точну вартість називаю після короткого брифу. Нижче орієнтири.</p>

  <div class="grid">
    {services.map((s, i) => (
      <article class:list={['card', 'spot', { popular: s.popular }]} data-reveal style={`--i:${i}`}>
        {s.popular && <span class="badge">Найчастіше обирають</span>}
        <h3>{s.title}</h3>
        <p class="for">{s.forWho}</p>
        <ul>{s.features.map((f) => <li>{f}</li>)}</ul>
        <div class="meta">
          <div><span class="label">Термін</span><strong>{s.term}</strong></div>
          <div><span class="label">Вартість</span><strong>{s.price}</strong></div>
        </div>
        <a class="btn" href="#contact" data-service={s.title}>Обговорити проєкт</a>
      </article>
    ))}
  </div>
</section>

<style>
  .grid { display: grid; gap: 1.25rem; align-items: stretch; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .card {
    position: relative; display: flex; flex-direction: column; gap: 1rem; padding: 1.9rem;
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 22px;
  }
  .card h3 { font-size: 1.35rem; }
  .for { color: var(--muted); }
  ul { list-style: none; display: grid; gap: .5rem; }
  li { position: relative; padding-left: 1.5rem; font-size: .95rem; }
  li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: 800; }
  .meta { display: flex; gap: 1.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px dashed rgba(255, 255, 255, .18); }
  .label { display: block; color: var(--muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
  .meta strong { font-size: 1.1rem; }
  .card .btn { margin-top: .5rem; }

  /* популярний тариф: повністю жовтий */
  .card.popular {
    background: var(--accent); border-color: var(--accent); color: #111;
    transform: translateY(-10px); box-shadow: 0 30px 70px rgba(255, 210, 0, .18);
  }
  .card.popular { --spot: 17, 17, 17; }
  .card.popular .for, .card.popular .label { color: rgba(17, 17, 17, .72); }
  .card.popular li::before { color: #111; }
  .card.popular .meta { border-color: rgba(17, 17, 17, .3); }
  .card.popular .btn { background: #111; border-color: #111; color: var(--accent); }
  .badge {
    position: absolute; top: -13px; left: 1.5rem; padding: .25rem .8rem; border-radius: 999px;
    background: #111; color: var(--accent); font-size: .75rem; font-weight: 800;
  }

  @media (max-width: 760px) { .card.popular { transform: none; } }
</style>
<script>
  // підставляємо обраний тариф у форму заявки
  document.querySelectorAll<HTMLAnchorElement>('a[data-service]').forEach((a) =>
    a.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#lead-form select[name="project"]');
      if (select && a.dataset.service) select.value = a.dataset.service;
    })
  );
</script>
