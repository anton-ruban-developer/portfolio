---
import { useT, localizePath } from '../i18n';
import { servicesFor, serviceUi } from '../data/services';
import { promoEnd } from '../data/site';

const { lang, t } = useT(Astro.currentLocale);
// посилання «Детальніше» на сторінку тарифу, якщо вона вже є цією мовою
const pageOf = (i: number) => {
  const s = servicesFor(lang).find((x) => x.index === i);
  return s ? localizePath(lang, `/${s.slug}/`) : null;
};
const st = t.services;
// акцію не рендеримо, якщо сайт зібрано вже після її кінця; якщо до, то її сховає скрипт нижче
const promoActive = Date.now() < promoEnd.getTime();
---

<section class="section container" id="services" data-promo-end={promoEnd.toISOString()}>
  <p class="eyebrow">{st.eyebrow}</p>
  <h2>{st.title}</h2>
  <p class="lead">{st.lead}</p>

  <div class="grid">
    {st.items.map((s, i) => (
      <article
        class:list={['card', 'spot', { popular: s.popular, promo: promoActive && s.promoPrice }]}
        data-reveal style={`--i:${i}`}
      >
        {s.popular && <span class="badge">{st.popular}</span>}
        {promoActive && s.promoPrice && <span class="badge promo-badge">{st.promoBadge}</span>}
        <h3>{s.title}</h3>
        {s.forWho && <p class="for">{s.forWho}</p>}
        <ul>{s.features.map((f) => <li>{f}</li>)}</ul>
        <div class="meta">
          <div><span class="label">{st.term}</span><strong>{s.term}</strong></div>
          <div>
            <span class="label">{st.price}</span>
            {promoActive && s.promoPrice
              ? <><s class="old">{s.price}</s><strong class="promo-price">{s.promoPrice}</strong><strong class="base-price">{s.price}</strong></>
              : <strong>{s.price}</strong>}
          </div>
        </div>
        <a class="btn" href="#contact" data-service={s.title}>{t.ui.discuss}</a>
        {pageOf(i) && <a class="more" href={pageOf(i)}>{serviceUi[lang].more}</a>}
      </article>
    ))}
  </div>

  <p class="extras">{st.extras}</p>
</section>

<style>
  .grid { display: grid; gap: 1.25rem; align-items: stretch; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .card {
    position: relative; display: flex; flex-direction: column; gap: 1rem; padding: 1.9rem;
    background: var(--bg-soft); border: 1px solid var(--line); border-radius: 22px;
  }
  .card h3 { font-size: 1.35rem; }
  .for { color: var(--muted); }
  ul { list-style: none; display: grid; gap: .5rem; }
  li { position: relative; padding-left: 1.5rem; font-size: .95rem; }
  li::before { content: '✓'; position: absolute; left: 0; color: var(--accent); font-weight: 800; }
  .meta { display: flex; gap: 1.5rem; margin-top: auto; padding-top: 1rem; border-top: 1px dashed rgba(255, 255, 255, .18); }
  .label { display: block; color: var(--muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; }
  .meta strong { font-size: 1.1rem; }
  .card .btn { margin-top: .5rem; }
  .more { align-self: center; font-weight: 700; font-size: .9rem; color: var(--accent); text-decoration: none; }
  .more:hover { text-decoration: underline; }
  .card.popular .more { color: #111; }

  /* популярний тариф: повністю жовтий */
  .card.popular {
    background: var(--accent); border-color: var(--accent); color: #111;
    transform: translateY(-10px); box-shadow: 0 30px 70px rgba(255, 210, 0, .18);
  }
  .card.popular { --spot: 17, 17, 17; }
  .card.popular .for, .card.popular .label { color: rgba(17, 17, 17, .72); }
  .card.popular li::before { color: #111; }
  .card.popular .meta { border-color: rgba(17, 17, 17, .3); }
  .card.popular .btn { background: #111; border-color: #111; color: var(--accent); }
  .badge {
    position: absolute; top: -13px; left: 1.5rem; padding: .25rem .8rem; border-radius: 999px;
    background: #111; color: var(--accent); font-size: .75rem; font-weight: 800;
  }

  /* акція */
  .promo-badge { left: auto; right: 1.5rem; background: #ff5a3c; color: #fff; }
  .old { display: block; color: var(--muted); font-size: .85rem; }
  .promo-price { color: var(--accent); }
  .card.popular .promo-price { color: #111; }
  .base-price { display: none; }
  /* акція закінчилась (клас знімає скрипт): звичайна ціна */
  .card:not(.promo) .old, .card:not(.promo) .promo-price, .card:not(.promo) .promo-badge { display: none; }
  .card:not(.promo) .base-price { display: inline; }

  .extras { margin-top: 2rem; max-width: 70ch; color: var(--muted); font-size: .92rem; }

  @media (max-width: 760px) { .card.popular { transform: none; } }
</style>
<script>
  // акція закінчилась, а сайт ще не перезібрали: прибираємо знижку (дата з data-promo-end)
  const promoEndAt = Date.parse(document.getElementById('services')?.dataset.promoEnd ?? '');
  if (Date.now() > promoEndAt) {
    document.querySelectorAll('#services .card.promo').forEach((c) => c.classList.remove('promo'));
  }

  // підставляємо обраний тариф у форму заявки
  document.querySelectorAll<HTMLAnchorElement>('a[data-service]').forEach((a) =>
    a.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#lead-form select[name="project"]');
      if (select && a.dataset.service) select.value = a.dataset.service;
    })
  );
</script>
