---
import { site, emailEncoded, emailMasked } from '../data/site';
import { useT, localizePath } from '../i18n';
import { servicesFor } from '../data/services';

const { lang, t, home } = useT(Astro.currentLocale);
const year = new Date().getFullYear();
// дві короткі колонки посилань замість одного довгого списку
const serviceNav = servicesFor(lang).map((s) => ({ href: localizePath(lang, `/${s.slug}/`), label: t.services.items[s.index].title }));
const nav = [
  { href: localizePath(lang, '/works/'), label: t.nav.portfolio },
  { href: `${home}#process`, label: t.nav.process },
  { href: `${home}#why`, label: t.nav.why },
  { href: `${home}#faq`, label: t.nav.faq },
  { href: localizePath(lang, '/contacts/'), label: t.nav.contact },
];
const contacts = [
  { label: 'Telegram', value: site.telegramHandle, href: site.telegram, ext: true },
  { label: t.contact.phone, value: site.phoneLabel, href: `tel:${site.phone}` },
  { label: 'Email', value: emailMasked, href: '#contact', email: emailEncoded },
];
---

<footer class="footer">
  <div class="container cols">
    <div class="brand">
      <a class="logo" href={home} aria-label={`${site.name}: ${t.ui.toHome}`}>
        {site.logo
          ? <img src={site.logo} alt={site.name} width="167" height="40" loading="lazy" decoding="async" />
          : <span class="logo-text">{site.name}</span>}
      </a>
      <p class="about">{t.footer.about}</p>
      <span class="status"><i></i> {t.ui.acceptingProjects}</span>
    </div>

    {serviceNav.length > 0 && (
      <nav aria-label={t.nav.services}>
        <h3>{t.nav.services}</h3>
        <ul class="nav">
          {serviceNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    )}

    <nav aria-label={t.footer.navLabel}>
      <h3>{t.footer.sections}</h3>
      <ul class="nav">
        {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h3>{t.footer.contacts}</h3>
      <ul class="contacts">
        {contacts.map((c) => (
          <li>
            <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined} data-email={c.email}>
              <span class="k">{c.label}</span>
              <span class="v" data-email-text={c.email ? true : undefined}>{c.value}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="clock">{t.city} · <time id="kh-time">--:--</time> <small>{t.footer.timeNote}</small></p>
    </div>
  </div>

  <div class="mega-wrap" aria-hidden="true">
    <p class="mega">{site.name}</p>
  </div>

  <div class="container bottom">
    <p>© {year} {site.name}. {t.footer.rights} <a class="privacy" href={localizePath(lang, '/privacy/')}>{t.footer.privacy}</a></p>
    <a class="up" href="#top" aria-label={t.footer.up}>{t.footer.up} <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .footer {
    position: relative; isolation: isolate; overflow: hidden;
    background: #0a0d12; border-top: 1px solid rgba(255, 255, 255, .08);
  }
  /* жовте світіння та сітка зверху, як у першому екрані */
  .footer::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(700px 300px at 50% 0%, rgba(255, 210, 0, .08), transparent 70%);
  }
  .footer::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .035) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, #000 10%, transparent 65%);
    mask-image: radial-gradient(ellipse at 50% 0%, #000 10%, transparent 65%);
  }

  .logo { display: inline-flex; align-items: center; text-decoration: none; }
  .logo img { height: 40px; width: auto; }
  .logo-text { font-family: var(--font-head); font-weight: 800; font-size: 1.2rem; color: var(--accent); }
  .about { margin: .8rem 0 1rem; color: var(--muted); font-size: .9rem; max-width: 34ch; }
  .status {
    display: inline-flex; align-items: center; gap: .6rem; padding: .5rem 1rem; border-radius: 999px;
    border: 1px solid rgba(40, 200, 64, .35); background: rgba(40, 200, 64, .08); font-size: .85rem; font-weight: 600;
  }
  .status i { width: 8px; height: 8px; border-radius: 50%; background: #28c840; animation: pulse 2s infinite; }
  @keyframes pulse { to { box-shadow: 0 0 0 8px rgba(40, 200, 64, 0); } }

  .cols { display: grid; grid-template-columns: 1.4fr .9fr .8fr 1.2fr; gap: 2rem; padding: clamp(2.5rem, 5vw, 3.5rem) 0 2rem; }
  h3 { margin-bottom: .8rem; font-family: var(--font-body); font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--muted); }
  ul { list-style: none; }

  .nav { display: grid; gap: .4rem; }
  .nav a { font-size: .95rem; }
  .nav a { position: relative; text-decoration: none; color: var(--text); transition: color .2s, padding .25s; }
  .nav a::before {
    content: ''; position: absolute; left: 0; top: 50%; width: 0; height: 2px; background: var(--accent);
    transition: width .25s;
  }
  .nav a:hover { color: var(--accent); padding-left: 1.1rem; }
  .nav a:hover::before { width: .7rem; }

  .contacts { display: grid; gap: .45rem; }
  .contacts a { display: grid; grid-template-columns: 4.8rem 1fr; align-items: baseline; gap: .5rem; text-decoration: none; color: var(--text); }
  .k { color: var(--muted); font-size: .8rem; }
  .v { font-weight: 600; overflow-wrap: anywhere; transition: color .2s; }
  .v { font-size: .95rem; }
  .contacts a:hover .v { color: var(--accent); }

  .clock { margin-top: 1rem; color: var(--muted); font-size: .85rem; }
  .clock time { color: var(--text); font-weight: 700; font-variant-numeric: tabular-nums; }

  /* величезна назва бренду: заливка без контуру (контур на змінному шрифті дає артефакти) */
  .mega-wrap { padding: 0 1rem; text-align: center; overflow: hidden; }
  .mega {
    display: inline-block; font-family: var(--font-head); font-weight: 800; text-transform: uppercase;
    white-space: nowrap; line-height: .85; letter-spacing: -.02em; user-select: none;
    font-size: 6vw; /* точний розмір підбирає скрипт */
    color: transparent;
    background: linear-gradient(90deg, var(--accent) 50%, rgba(255, 255, 255, .06) 50%) no-repeat 100% 0 / 200% 100%;
    -webkit-background-clip: text; background-clip: text;
    transition: background-position 1.1s cubic-bezier(.6, 0, .2, 1);
  }
  .mega:hover { background-position: 0 0; }
  @media (hover: none) { .mega.in-view { background-position: 0 0; } }

  .bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem;
    padding: 1rem 0 1.5rem; color: var(--muted); font-size: .85rem;
  }
  .privacy { margin-left: .5rem; color: var(--muted); }
  .privacy:hover { color: var(--accent); }
  .up {
    display: inline-flex; align-items: center; gap: .5rem; padding: .45rem .95rem; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, .15); color: var(--text); text-decoration: none; transition: border-color .2s, color .2s;
  }
  .up span { transition: transform .25s; }
  .up:hover { border-color: var(--accent); color: var(--accent); }
  .up:hover span { transform: translateY(-3px); }

  @media (max-width: 960px) {
    .cols { grid-template-columns: 1fr 1fr; gap: 1.75rem 2rem; }
  }
  @media (max-width: 520px) {
    /* на телефоні: бренд і контакти на всю ширину, дві колонки посилань поруч */
    .brand, .cols > div:last-child { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mega { transition: none; }
    .status i { animation: none; }
  }
</style>

<script>
  // живий час у Харкові
  const t = document.getElementById('kh-time');
  const fmt = new Intl.DateTimeFormat('uk-UA', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Kyiv' });
  const tick = () => { if (t) t.textContent = fmt.format(new Date()); };
  tick();
  setInterval(tick, 15000);

  // підганяємо розмір назви рівно під ширину; чекаємо, поки завантажиться шрифт
  const mega = document.querySelector<HTMLElement>('.mega');
  if (mega) {
    const fit = () => {
      const avail = mega.parentElement!.clientWidth - 32;
      mega.style.fontSize = '100px';
      const w = mega.getBoundingClientRect().width;
      if (w) mega.style.fontSize = `${Math.floor((100 * avail) / w * 10) / 10}px`;
    };
    fit();
    document.fonts?.load('800 100px "Unbounded Variable"').then(fit).catch(() => {});
    document.fonts?.ready.then(fit);
    window.addEventListener('resize', fit);

    if (window.matchMedia('(hover: none)').matches && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => mega.classList.toggle('in-view', e.isIntersecting), { threshold: 0.8 }).observe(mega);
    }
  }
</script>
