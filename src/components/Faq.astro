---
import { useT } from '../i18n';
import { site } from '../data/site';

const { t } = useT(Astro.currentLocale);
const faq = t.faq.items;
---

<section class="section container" id="faq">
  <div class="wrap">
    <div class="side" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2>{t.faq.title}</h2>
      <p class="lead">{t.faq.lead}</p>
      <a class="btn" href={site.telegram} target="_blank" rel="noopener">{t.faq.ask}</a>
    </div>

    <div class="list">
      {faq.map((item, i) => (
        <details class="spot" data-reveal style={`--i:${i}`}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .wrap { display: grid; grid-template-columns: .8fr 1.4fr; gap: clamp(2rem, 6vw, 4rem); align-items: start; }
  .side { position: sticky; top: 100px; }
  .side .lead { margin-bottom: 1.5rem; }
  .list { display: grid; gap: .75rem; }
  details { background: var(--bg-soft); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  summary { position: relative; padding: 1.15rem 3.2rem 1.15rem 1.4rem; cursor: pointer; font-weight: 700; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 1.3rem; top: 50%; transform: translateY(-50%); color: var(--accent); font-size: 1.6rem; line-height: 1; }
  details[open] summary::after { content: '−'; }
  details[open] summary { border-bottom: 1px dashed var(--line); }
  details p { padding: 1rem 1.4rem 1.3rem; color: var(--muted); }
  @media (max-width: 860px) {
    .wrap { grid-template-columns: 1fr; }
    .side { position: static; }
  }
</style>