---
import '@fontsource-variable/inter';
import '@fontsource-variable/unbounded/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import { site } from '../data/site';
import { useT, locales, defaultLocale, langMeta, stripLocale, localizePath } from '../i18n';

interface Props {
  /** за замовчуванням беруться з словника мови (meta.title / meta.description) */
  title?: string;
  description?: string;
}

const { lang, t } = useT(Astro.currentLocale);
const { title = t.meta.title, description = t.meta.description } = Astro.props;

// якщо `site` не задано в astro.config, беремо адресу поточного запиту
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL('/og.png', base);

// hreflang: та сама сторінка всіма мовами, щоб пошуковик показував людям версію їхньою мовою
const pagePath = stripLocale(Astro.url.pathname);
const alternates = locales.map((l) => ({ lang: l, href: new URL(localizePath(l, pagePath), base).href }));
const xDefault = new URL(localizePath(defaultLocale, pagePath), base).href;

// Розмітка Schema.org: допомагає Google показувати сайт у локальному пошуку
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description,
  url: canonical.href,
  inLanguage: lang,
  knowsLanguage: [...locales],
  image: ogImage.href,
  telephone: site.phone,
  areaServed: lang === 'en' ? ['UA', 'US'] : 'UA',
  address: { '@type': 'PostalAddress', addressLocality: t.city.split(',')[0], addressCountry: 'UA' },
  sameAs: [site.telegram],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!Astro.site && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0e1116" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={langMeta[lang].ogLocale} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={langMeta[l].ogLocale} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add('js');</script>

    {site.gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
        <script is:inline define:vars={{ gaId: site.gaId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <MobileCta />

    <script>
      // пошта лежить у сторінці закодованою, щоб її не збирали спам-боти; розкодовуємо в браузері
      document.querySelectorAll<HTMLAnchorElement>('a[data-email]').forEach((a) => {
        const email = atob(a.dataset.email ?? '');
        a.href = `mailto:${email}`;
        const label = a.querySelector('[data-email-text]') ?? a;
        label.textContent = email;
      });

      // аналітика: кліки по контактах (працює, тільки якщо в site.ts задано gaId)
      document.addEventListener('click', (e) => {
        const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href]');
        const gtag = (window as any).gtag;
        if (!a || typeof gtag !== 'function') return;
        const href = a.getAttribute('href') ?? '';
        const method = href.startsWith('https://t.me/') ? 'telegram' : href.startsWith('tel:') ? 'phone' : href.startsWith('mailto:') ? 'email' : '';
        if (method) gtag('event', 'contact_click', { method });
      });

      // плавна поява блоків з data-reveal
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }

      // підсвітка карток .spot: передаємо координати курсора в CSS
      if (window.matchMedia('(hover: hover)').matches) {
        document.addEventListener(
          'pointermove',
          (e) => {
            const el = (e.target as Element | null)?.closest<HTMLElement>('.spot');
            if (!el) return;
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${e.clientX - r.left}px`);
            el.style.setProperty('--my', `${e.clientY - r.top}px`);
          },
          { passive: true }
        );
      }
    </script>
  </body>
</html>
